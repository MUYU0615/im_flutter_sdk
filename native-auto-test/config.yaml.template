# native-auto-test 控制端本地配置模板。
# 复制为 config.yaml 后填写真实 app key、REST 凭据、账号和 SDK options。
# config.yaml 已被 .gitignore 忽略，不提交、不打包、不放入 Flutter assets。

# WebSocket 控制通道配置。
# runner 会把 bridge URL / topic 通过启动参数或 WebSocket 编排下发给 im_flutter_test。
# 不再维护 flutter_config.yaml，也不允许 im_flutter_test/assets/config.yaml 承载这些配置。
websocket:
  # 本地长期回归建议先启动：
  #   python -m src.tools.local_ws_relay --host 127.0.0.1 --port 2000
  base_url: "ws://127.0.0.1:2000/iov/websocket/dual"
  default_topic: "adc"
  # 设置 NATIVE_AUTO_TEST_RUN_ID 时，topic 会按
  #   {topic_prefix}-{run_id}-{device}
  # 动态生成，例如 im-auto-20260618-153012-webA。
  topic_prefix: "im-auto"
  connect_timeout: 10
  response_timeout: 30

# Web SDK 执行模式：
# - real_sdk：通过 im_flutter_sdk_web 调用真实 Web IM SDK / 真实 IM 服务端。
# - local_adapter：仅在明确做 wrapper JSON 映射验证时手动指定。
web:
  sdk_mode: real_sdk

# REST 用户管理（创建/删除用户，用于 presence 等用例的临时账号）
rest_api:
  # 只配置 REST host 前缀；完整 URL 会由 app_key pin 成：
  #   {base_url}/{org_name}/{app_name}
  base_url: "http://a1.easemob.com"
  app_key: "your_org_name#your_app_name"
  # 已有 token 时优先使用 auth_token，不会再请求 client_id/client_secret。
  auth_token: ""
  # 未配置 auth_token 时，框架会 POST {base_url}/token 获取 access_token。
  client_id: "your_client_id"
  client_secret: "your_client_secret"
  verify_ssl: false  # 临时绕过证书校验（仅测试环境使用）

# Flutter SDK EMOptions / SDK init 配置。
# 本节真实值只写入本地 config.yaml，由 src/tools/sdk_options_resolver.py 校验并转换成
# bridge Client.init JSON；im_flutter_test 不读取本地 yaml，也不内置 sdk_config_loader.dart。
sdk_options:
  app_key: "your_org_name#your_app_name"
  # rest_server: "https://a1-hsb.easemob.com"
  # im_server: "42.193.118.34"
  # im_port: 6717
  # web_socket_server: "im-api-new-hsb.easemob.com"
  # web_socket_port: 80
  auto_login: true
  debug_mode: true
  enable_dns_config: true
  sync_data_web_socket_server: "140.143.132.6"
  sync_data_web_socket_port: 8086
  require_ack: true
  enable_auto_sync_contacts: false
  enable_user_info: true

# SDK E2E 默认运行配置。
e2e:
  # 第一阶段只支持 existing：使用已经在线的设备或客户端。
  device_mode: existing
  # 默认矩阵模式。pair 表示按当前 context 做成对互测。
  matrix_mode: pair
  # 默认安装模式。第一阶段只记录到 context，不执行安装编排。
  install_mode: clean
  # 第一阶段只支持 fresh。
  account_mode: fresh

# E2E fresh 账号策略。真实密码只写入本地 config.yaml。
accounts:
  default_password: ""
  user_id_prefix: "im_e2e"
  create_retry: 5
  # 如需使用已存在账号，可在本地 config.yaml 中显式指定；不要提交真实账号。
  # users:
  #   a: "existing_user_a"
  #   b: "existing_user_b"
  #   c: "existing_user_c"
