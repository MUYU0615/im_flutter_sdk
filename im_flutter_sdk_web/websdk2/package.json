{
  "name": "easemob-websdk",
  "version": "0.14.161",
  "description": "高性能、类型安全、可扩展的即时通讯 SDK",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./managers/chat": {
      "types": "./dist/managers/chat/index.d.ts",
      "import": "./dist/managers/chat/index.js",
      "require": "./dist/managers/chat/index.cjs"
    },
    "./managers/chat-thread": {
      "types": "./dist/managers/chat-thread/index.d.ts",
      "import": "./dist/managers/chat-thread/index.js",
      "require": "./dist/managers/chat-thread/index.cjs"
    },
    "./managers/chatroom": {
      "types": "./dist/managers/chatroom/index.d.ts",
      "import": "./dist/managers/chatroom/index.js",
      "require": "./dist/managers/chatroom/index.cjs"
    },
    "./managers/contact": {
      "types": "./dist/managers/contact/index.d.ts",
      "import": "./dist/managers/contact/index.js",
      "require": "./dist/managers/contact/index.cjs"
    },
    "./managers/group": {
      "types": "./dist/managers/group/index.d.ts",
      "import": "./dist/managers/group/index.js",
      "require": "./dist/managers/group/index.cjs"
    },
    "./managers/presence": {
      "types": "./dist/managers/presence/index.d.ts",
      "import": "./dist/managers/presence/index.js",
      "require": "./dist/managers/presence/index.cjs"
    },
    "./managers/push": {
      "types": "./dist/managers/push/index.d.ts",
      "import": "./dist/managers/push/index.js",
      "require": "./dist/managers/push/index.cjs"
    },
    "./managers/user-info": {
      "types": "./dist/managers/user-info/index.d.ts",
      "import": "./dist/managers/user-info/index.js",
      "require": "./dist/managers/user-info/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "npm run proto:check && npm run errors:runtime:gen",
    "build": "vite build && npm run build:types && vite build --mode bundle",
    "build:ai-kit": "npm --prefix packages/websdk2-ai-kit run build",
    "release:ai-kit:check": "node scripts/release/ai-kit-release.mjs check",
    "release:ai-kit:pack": "node scripts/release/ai-kit-release.mjs pack",
    "release:ai-kit:pack:dry-run": "node scripts/release/ai-kit-release.mjs pack --dry-run",
    "release:ai-kit:publish": "node scripts/release/ai-kit-release.mjs publish",
    "release:ai-kit:publish:dry-run": "node scripts/release/ai-kit-release.mjs publish --dry-run",
    "dev": "vite build --watch",
    "seed:demo-users": "node scripts/seed-demo-users.mjs",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage --run",
    "proto:gen": "node scripts/generate-msync-proto.js && node scripts/generate-roster-proto.js",
    "proto:check": "node scripts/generate-msync-proto.js --check && node scripts/generate-roster-proto.js --check",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "docs:api": "npm run docs:api:html",
    "docs:api:zh": "npm run docs:api:html:zh",
    "docs:api:en": "npm run docs:api:html:en",
    "docs:api:html": "npm run docs:api:errors && npm run docs:api:html:zh && npm run docs:api:html:en",
    "docs:api:html:zh": "node scripts/generate-typedoc-html.js --lang zh-CN --out docs-site/api/zh-CN",
    "docs:api:html:en": "node scripts/generate-typedoc-html.js --lang en-US --out docs-site/api/en-US",
    "docs:api:md": "npm run docs:api:md:zh && npm run docs:api:md:en",
    "docs:api:md:zh": "node scripts/generate-api-reference.js --lang zh-CN --output docs/reference/api-reference.zh-CN.md",
    "docs:api:md:en": "node scripts/generate-api-reference.js --lang en-US --output docs/reference/api-reference.en-US.md",
    "docs:api:comments": "node scripts/check-api-doc-comments.js",
    "docs:api:check": "npm run docs:api:comments && npm run docs:api:html",
    "docs:api:errors": "node scripts/generate-error-locale-packs.mjs && node scripts/generate-api-error-docs.mjs && node scripts/generate-canonical-error-docs.mjs && node scripts/generate-typedoc-error-docs.mjs --lang zh-CN",
    "docs:errors": "node scripts/generate-errors-docs.js",
    "errors:check": "node scripts/check-error-code-governance.mjs && npm run errors:locale:check",
    "errors:locale:gen": "node scripts/generate-error-locale-packs.mjs",
    "errors:locale:check": "node scripts/check-error-locale-coverage.mjs",
    "errors:runtime:gen": "node scripts/generate-runtime-error-maps.mjs",
    "errors:runtime:check": "node scripts/check-runtime-error-maps.mjs",
    "type-check": "tsc --noEmit",
    "build:bundle": "vite build --mode bundle",
    "bundle:analyze": "ANALYZE_BUNDLE=1 vite build",
    "bundle:analyze:full": "ANALYZE_BUNDLE=1 vite build --mode bundle",
    "bundle:analyze:summary": "node scripts/summarize-visualizer.mjs",
    "tree-shaking:check": "node scripts/check-tree-shaking.mjs",
    "build:types": "tsc --project tsconfig.build.json",
    "test:integration": "npm run test:run -- tests/integration",
    "test:integration:mock": "npm run test:run -- tests/integration/mock",
    "test:smoke:real-env": "node scripts/test/run-real-env-core.mjs",
    "test:real-env": "REAL_ENV_ENABLE=1 npx vitest run tests/real-env/ --fileParallelism=false --sequence.concurrent=false",
    "test:e2e": "npx playwright test tests/e2e --project=chromium",
    "test:e2e:api": "npx playwright test tests/e2e/api --project=chromium",
    "test:e2e:demo": "npx playwright test tests/e2e/demo --project=chromium",
    "test:ai-kit": "npm run test:run -- tests/unit/ai-kit tests/integration/ai-kit",
    "test:gate:pr": "node scripts/test/run-layered-tests.mjs --policy pr_gate",
    "test:gate:nightly": "node scripts/test/run-layered-tests.mjs --policy nightly_full",
    "test:gate:release": "node scripts/test/run-layered-tests.mjs --policy release_gate"
  },
  "keywords": [
    "im",
    "sdk",
    "websocket",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "eslint": "^8.0.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.0.0",
    "rollup-plugin-visualizer": "^6.0.11",
    "terser": "^5.46.1",
    "typedoc": "^0.27.9",
    "typescript": "^5.0.0",
    "vite": "^7.3.2",
    "vitest": "^3.2.4",
    "ws": "^8.18.3"
  },
  "dependencies": {
    "long": "^5.2.3",
    "protobufjs": "^7.0.0",
    "zod": "^3.22.0"
  },
  "overrides": {
    "rollup": "^4.59.0",
    "ajv": "^6.14.0",
    "flatted": "^3.4.2",
    "yaml": "^2.8.3",
    "minimatch@^3.1.2": "^3.1.4",
    "brace-expansion@^1.1.7": "^1.1.14",
    "brace-expansion@^2.0.1": "^2.0.3"
  },
  "sideEffects": false,
  "unpkg": "./dist/bundle/im-sdk-web.iife.js",
  "jsdelivr": "./dist/bundle/im-sdk-web.iife.js"
}
