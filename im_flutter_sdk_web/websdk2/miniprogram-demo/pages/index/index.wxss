.page {
  padding: 28rpx 24rpx 48rpx;
}

.hero {
  padding: 36rpx 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #0f172a, #1d4ed8 65%, #60a5fa);
  color: #eff6ff;
  box-shadow: 0 20rpx 48rpx rgba(15, 23, 42, 0.18);
}

.hero-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
}

.hero-subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(239, 246, 255, 0.82);
}

.hero-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.meta-chip {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: 22rpx;
}

.card {
  margin-top: 24rpx;
  padding: 28rpx 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(15, 23, 42, 0.08);
}

.card-title {
  margin-bottom: 20rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}

.field {
  margin-bottom: 20rpx;
}

.label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 24rpx;
  color: #475569;
}

.input,
.picker,
.textarea {
  width: 100%;
  min-height: 82rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border: 2rpx solid #dbe4f0;
  border-radius: 18rpx;
  background: #f8fafc;
  color: #0f172a;
}

.textarea {
  min-height: 180rpx;
}

.picker {
  display: flex;
  align-items: center;
}

.button-row {
  display: flex;
  gap: 16rpx;
}

.primary-btn,
.ghost-btn {
  margin-top: 8rpx;
  font-size: 28rpx;
}

.primary-btn {
  background: #0f766e;
  color: #ffffff;
}

.ghost-btn {
  background: #e2e8f0;
  color: #0f172a;
}

.half-btn {
  flex: 1;
}

.hint {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #64748b;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.selection {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #0f172a;
}

.empty-log {
  color: #94a3b8;
  font-size: 24rpx;
}

.log-item {
  display: grid;
  grid-template-columns: 118rpx 100rpx 1fr;
  gap: 14rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #e2e8f0;
}

.log-item:last-child {
  border-bottom: none;
}

.log-time,
.log-level,
.log-message {
  font-size: 22rpx;
}

.log-time,
.log-level {
  color: #64748b;
}

.log-info .log-message {
  color: #0f172a;
}

.log-success .log-message {
  color: #166534;
}

.log-warn .log-message {
  color: #b45309;
}

.log-error .log-message {
  color: #b91c1c;
}
